# Copier vers .env pour le développement
# Sur Vercel : Project Settings → Environment Variables
# Dashboard : https://supabase.com/dashboard/project/bmkvwgrpgntpvkngcfku/settings/database

# Postgres Supabase — Transaction pooler (runtime Prisma / Vercel)
# Settings → Database → Connection string → URI → Mode: Transaction
DATABASE_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres Supabase — connexion directe (prisma migrate / seed)
# Settings → Database → Connection string → URI → Mode: Session (ou Direct)
# IMPORTANT : ce rôle doit OWN les tables public (sinon P3018 / must be owner).
DIRECT_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@db.bmkvwgrpgntpvkngcfku.supabase.co:5432/postgres"

# NextAuth
# ⚠️ NEXTAUTH_URL : en production, doit être l'URL publique Vercel exacte
# ex. https://get-admission-two.vercel.app (sans slash final)
NEXTAUTH_URL="http://localhost:3000"

# ⚠️ NEXTAUTH_SECRET : CRITIQUE — générer un secret fort unique pour la production
# Commande : openssl rand -base64 64
# Injecter dans Vercel → Project Settings → Environment Variables (env: Production uniquement)
# Ne JAMAIS utiliser la valeur ci-dessous en production.
NEXTAUTH_SECRET="REMPLACER-PAR-openssl-rand-base64-64"

# Supabase Auth (OTP e-mail candidats)
# Dashboard → Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL="https://bmkvwgrpgntpvkngcfku.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...ou sb_publishable_..."
# Service role : Settings → API Keys → secret (JAMAIS en NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="eyJ...ou sb_secret_..."

# E-mails transactionnels (confirmation paiement, vérification e-mail, reset mot de passe)
# ⚠️ REQUIS EN PRODUCTION : sans Resend, aucun e-mail n'est envoyé aux candidats
# Dashboard : https://resend.com → API Keys
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM="Tonomi <noreply@votre-domaine-verifie.com>"

# Comptes démo du seed (optionnel)
# SEED_DEMO_PASSWORD=

# Passerelle paiement GeniusPay (Wave, Orange Money, MTN, Carte)
# ⚠️ EN PRODUCTION : utiliser les clés LIVE (pas sandbox)
# Clés sandbox commencent par sk_sandbox_ / ss_sandbox_
# Clés live commencent par sk_live_ / ss_live_
# Dashboard : https://geniuspay.ci/dashboard
# GENIUSPAY_API_KEY="sk_live_xxxxxxxx"
# GENIUSPAY_API_SECRET="ss_live_xxxxxxxx"
# GENIUSPAY_API_URL="https://geniuspay.ci/api/v1/merchant"
# GENIUSPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Passerelle paiement PayTech (optionnel, fallback si GeniusPay absent)
# Dashboard : https://paytech.sn (Business → API Keys)
# ⚠️ Mettre PAYTECH_ENV=prod en production
# PAYTECH_API_KEY=
# PAYTECH_API_SECRET=
# PAYTECH_API_URL="https://paytech.sn/api/payment/request-payment"
# PAYTECH_ENV=prod

# Rate limiting distribué (Upstash Redis)
# ⚠️ RECOMMANDÉ EN PRODUCTION : sans ces clés, le rate limiting est par instance mémoire
# et contournable sur Vercel (multi-instance Serverless).
# Configuration : Vercel → Storage → Marketplace → Upstash → créer + connecter au projet
# ou https://console.upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
