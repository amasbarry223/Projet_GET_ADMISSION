# Copier vers .env pour le développement
# Sur Vercel : Project Settings → Environment Variables
# Dashboard : https://supabase.com/dashboard/project/bmkvwgrpgntpvkngcfku/settings/database

# Postgres Supabase — Transaction pooler (runtime Prisma / Vercel)
# Settings → Database → Connection string → URI → Mode: Transaction
DATABASE_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres Supabase — connexion directe (prisma migrate / seed)
# Settings → Database → Connection string → URI → Mode: Session (ou Direct)
DIRECT_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@db.bmkvwgrpgntpvkngcfku.supabase.co:5432/postgres"

# NextAuth (obligatoire en production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# E-mails transactionnels (Resend) — OBLIGATOIRE en production pour la vérif d'inscription
# 1. Créer un compte https://resend.com → API Keys
# 2. Vérifier un domaine (Domaines) puis utiliser une adresse de ce domaine
# 3. Sur Vercel : Project Settings → Environment Variables (Production + Preview)
RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="GET Admission <noreply@votre-domaine-verifie.com>"
# En prod : NEXTAUTH_URL doit être l'URL publique (ex. https://get-admission-two.vercel.app)

# Optionnel — comptes démo du seed
# SEED_DEMO_PASSWORD=

# Optionnel — passerelle paiement (BF-19, Lot C — non branché)
# PAYMENT_PROVIDER=paydunya|cinetpay|flutterwave
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
