# Copier vers .env pour le développement
# Sur Vercel : Project Settings → Environment Variables
# Dashboard : https://supabase.com/dashboard/project/bmkvwgrpgntpvkngcfku/settings/database

# Postgres Supabase — Transaction pooler (runtime Prisma / Vercel)
# Settings → Database → Connection string → URI → Mode: Transaction
# Peut être postgres.<ref> OU un rôle app (ex. getadm_app.<ref>)
DATABASE_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres Supabase — connexion directe (prisma migrate / seed)
# Settings → Database → Connection string → URI → Mode: Session (ou Direct)
# IMPORTANT : ce rôle doit OWN les tables public (sinon P3018 / must be owner).
# Si tu utilises getadm_app ici, exécute une fois scripts/reassign-public-owner-to-app.sql
DIRECT_URL="postgresql://postgres.bmkvwgrpgntpvkngcfku:[PASSWORD]@db.bmkvwgrpgntpvkngcfku.supabase.co:5432/postgres"

# NextAuth (obligatoire en production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Supabase Auth (OTP e-mail candidats — sans Resend)
# Dashboard → Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL="https://bmkvwgrpgntpvkngcfku.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...ou sb_publishable_..."
# Service role : Settings → API Keys → secret (JAMAIS en NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="eyJ...ou sb_secret_..."

# E-mails métier optionnels (paiements / workflow) — plus requis pour l'auth candidats
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM="GET Admission <noreply@votre-domaine-verifie.com>"
# En prod : NEXTAUTH_URL doit être l'URL publique (ex. https://get-admission-two.vercel.app)

# Optionnel — comptes démo du seed
# SEED_DEMO_PASSWORD=

# Optionnel — passerelle paiement PayTech (BF-19)
# Sans ces clés : /api/paiements/initiate retombe en mode "déclaration"
# (paiement enregistré en attente, validé manuellement par l'agence).
# Dashboard : https://paytech.sn (Business → API Keys)
# PAYTECH_API_KEY=
# PAYTECH_API_SECRET=
# PAYTECH_API_URL="https://paytech.sn/api/payment/request-payment"
# PAYTECH_ENV=test|prod

# Optionnel — rate limiting distribué (Upstash Redis via Vercel Marketplace)
# Sans ces clés : repli automatique sur un compteur en mémoire par instance
# (OK en dev local, mais contournable en prod multi-instance sur Vercel).
# Vercel → Storage → Marketplace Database Providers → Upstash → créer + connecter,
# ou directement https://console.upstash.com (REST API section).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
