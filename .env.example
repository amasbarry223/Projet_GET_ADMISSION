# Copier vers .env.local pour le développement
# Sur Vercel : Project Settings → Environment Variables

# SQLite (relatif à prisma/schema.prisma)
DATABASE_URL="file:../db/custom.db"

# NextAuth (obligatoire en production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Optionnel — e-mails
# RESEND_API_KEY=
